# ============================================================
# Document Intelligence Bot — Environment Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. Keep secrets out of source control.
# ============================================================

# ── Document Paths ────────────────────────────────────────────
# Absolute path to the folder containing release PDFs and Word docs
DOCS_DIR=C:/path/to/your/Release-Documents

# Absolute path to the folder containing Role Attributes Excel files
ROLE_ATTR_DIR=C:/path/to/your/Role-Attributes

# ── Vector Store Paths ────────────────────────────────────────
# Where ChromaDB / BM25 index persists data
CHROMA_DIR=data/chroma
BM25_PATH=data/bm25_index.pkl

# ── LLM Provider ─────────────────────────────────────────────
# Option A: Groq (fast, good for dev/demo)
GROQ_API_KEY=<your-groq-api-key>
OLLAMA_BASE_URL=https://api.groq.com
OLLAMA_MODEL=llama-3.1-8b-instant

# Option B: Azure OpenAI (recommended for production)
# GROQ_API_KEY=<your-azure-openai-key>
# OLLAMA_BASE_URL=https://<resource-name>.openai.azure.com/openai/deployments/<deployment-name>
# OLLAMA_MODEL=gpt-4o-mini

# Option C: Local Ollama (fully air-gapped)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

OLLAMA_TIMEOUT=900
OLLAMA_NUM_PREDICT=3072

# ── Embedding + Re-ranking Models ────────────────────────────
# These are downloaded from HuggingFace on first run.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# ── PostgreSQL (pgvector) ────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=rag_db
PG_USER=postgres
# REQUIRED — generate a strong password:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PG_PASSWORD=<strong-random-password>

# ── Security ─────────────────────────────────────────────────
# CORS_ORIGINS: comma-separated list of allowed frontend origins
# Dev:  http://localhost:5173,http://localhost:5174
# Prod: https://your-bot.your-company.internal
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SSL certificate verification
# true (default), false (dev only), or path to your CA bundle
SSL_VERIFY=true

# ── Retrieval Tuning ─────────────────────────────────────────
TOP_K=8
RETRIEVAL_CANDIDATES=20
USE_HYBRID_SEARCH=true
USE_RERANKER=false
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
MAX_SECTION_PAGES=25
MAX_CONTEXT_CHARS=14000

# ── Chunking ─────────────────────────────────────────────────
CHILD_CHUNK_SIZE=200
CHILD_CHUNK_OVERLAP=40
PARENT_MAX_CHARS=1500

# ── Context Focus ─────────────────────────────────────────────
CONTEXT_FOCUS_ENABLED=true
CONTEXT_FOCUS_MAX_SOURCES=3
CONTEXT_FOCUS_PAGE_GAP=0.35

# ── Role Attribute Data Source ────────────────────────────────
# "excel"  → read from local Excel files in ROLE_ATTR_DIR (default)
# "mssql"  → fetch live from a remote SQL Server (requires MSSQL_* vars below)
ROLE_DATA_SOURCE=excel

# ── Remote MSSQL (optional — only if ROLE_DATA_SOURCE=mssql) ─
# Server: hostname, IP address, or IP\INSTANCE
MSSQL_SERVER=<your-mssql-server-ip-or-hostname>
MSSQL_DATABASE=<your-database-name>
# ODBC driver — check available drivers: python -c "import pyodbc; print(pyodbc.drivers())"
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TIMEOUT=30
# Leave blank for Windows Authentication (recommended for domain environments)
MSSQL_USER=<your-domain-username>
MSSQL_PASSWORD=<your-sql-server-password>

# ── Sync API (RDP proxy — only if using firewall-bridged MSSQL) ──
# A secret key shared between the RDP proxy server and this client
SYNC_API_KEY=<strong-random-secret>
