# Path to folder containing release PDFs and Word docs
# Set this to the absolute path on YOUR machine or server
# (no user-specific paths baked into source code)
DOCS_DIR=C:/path/to/your/Release-Documents

# Path to folder containing Role Attributes Excel files
ROLE_ATTR_DIR=C:/path/to/your/Role-Attributes

# Where ChromaDB persists data
CHROMA_DIR=data/chroma
BM25_PATH=data/bm25_index.pkl

# Ollama (open-source local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=900
OLLAMA_NUM_PREDICT=3072

# Embedding + re-ranking models (download on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# Retrieval
TOP_K=8
RETRIEVAL_CANDIDATES=20
USE_HYBRID_SEARCH=true
USE_RERANKER=false
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
MAX_SECTION_PAGES=25

# Parent-child chunking (child = search, parent = LLM context)
CHILD_CHUNK_SIZE=200
CHILD_CHUNK_OVERLAP=40
PARENT_MAX_CHARS=1500

# Focus retrieval on one page/section for procedural questions (how-to, configure, login)
CONTEXT_FOCUS_ENABLED=true
CONTEXT_FOCUS_MAX_SOURCES=3
CONTEXT_FOCUS_PAGE_GAP=0.35

# ── Security (new — required for production) ──────────────────
# Groq or Azure OpenAI API key
GROQ_API_KEY=gsk_...

# PostgreSQL password — MUST be set explicitly (no insecure default)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PG_PASSWORD=<strong-random-password>

# CORS allowed origins (comma-separated)
# Dev: http://localhost:5173
# Prod: https://project_name-bot.your-company.internal
CORS_ORIGINS=http://localhost:5173

# SSL certificate verification
# true (default), false (dev only), or path to corporate CA bundle
# SSL_VERIFY=/etc/ssl/certs/your-ca-bundle.pem
SSL_VERIFY=true

# ── Role Attribute Data Source ────────────────────────────────
ROLE_DATA_SOURCE=excel

# ── Remote MSSQL (PROJECT_NAME SQL Server) ───────────────────────────
MSSQL_SERVER=YOUR_MSSQL_SERVER_IP
MSSQL_DATABASE=PROJECT_NAME
MSSQL_DRIVER=SQL Server
MSSQL_TIMEOUT=30
MSSQL_USER=YOUR_DOMAIN_USERNAME
MSSQL_PASSWORD=<your-sql-server-password>


# ── Role Attribute Data Source ────────────────────────────────────────────────
# "excel"  → read from local Excel files in ROLE_ATTR_DIR (default, original behaviour)
# "mssql"  → fetch live from the remote PROJECT_NAME SQL Server (requires MSSQL_* vars below)
ROLE_DATA_SOURCE=excel

# ── Remote MSSQL (PROJECT_NAME SQL Server) ───────────────────────────────────────────
# Required when ROLE_DATA_SOURCE=mssql
#
# Server: hostname, IP, or IP\INSTANCE  (e.g. 10.154.219.164 or PRODEUM132PNB4)
MSSQL_SERVER=YOUR_MSSQL_SERVER_IP
MSSQL_DATABASE=PROJECT_NAME
#
# ODBC driver installed on the OS — check with: python -c "import pyodbc; print(pyodbc.drivers())"
# Built-in Windows driver (always present): "SQL Server"
# Modern driver (install separately if needed): "ODBC Driver 17 for SQL Server"
MSSQL_DRIVER=SQL Server
#
# Connection timeout in seconds
MSSQL_TIMEOUT=30
#
# SQL Server Login credentials (leave both blank to use Windows Authentication)
MSSQL_USER=YOUR_DOMAIN_USERNAME
MSSQL_PASSWORD=REDACTED_PASSWORD
