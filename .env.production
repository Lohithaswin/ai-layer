# ============================================================
# Document Intelligence Bot — Production Environment Template
# ============================================================
# Copy this to .env on your production VM/container and fill in real values.
# NEVER commit .env to git.
# For production, use a secrets manager (Azure Key Vault, HashiCorp Vault, etc.)
# ============================================================

# ── Document Paths (no user-specific paths!) ─────────────────
# Absolute path to the folder with release PDFs and Word docs
DOCS_DIR=/app/documents/release

# Absolute path to the folder with Role Attributes Excel files
ROLE_ATTR_DIR=/app/documents/role-attrs

# ── Vector Store Paths ────────────────────────────────────────
CHROMA_DIR=/app/data/chroma
BM25_PATH=/app/data/bm25_index.pkl

# ── LLM — Azure OpenAI (recommended for production) ──────────
# Data stays within your own Azure tenant; enterprise SLA, GDPR compliant.
GROQ_API_KEY=<your-azure-openai-key>
OLLAMA_BASE_URL=https://<resource-name>.openai.azure.com/openai/deployments/<deployment-name>
OLLAMA_MODEL=gpt-4o-mini
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=2048

# ── LLM — Groq (development / demo only) ─────────────────────
# GROQ_API_KEY=gsk_...
# OLLAMA_BASE_URL=https://api.groq.com
# OLLAMA_MODEL=llama-3.1-8b-instant

# ── Embedding & Reranker ──────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# ── PostgreSQL (pgvector) ────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=rag_db
PG_USER=rag_admin
# REQUIRED — no insecure default. Generate a strong password:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PG_PASSWORD=<strong-random-password>

# ── Security ─────────────────────────────────────────────────
# CORS_ORIGINS: comma-separated list of allowed frontend origins
# Dev:  http://localhost:5173
# Prod: https://your-bot.your-company.internal
CORS_ORIGINS=https://your-bot.your-company.internal

# SSL certificate verification
# true (default), false (dev only), or path to your corporate CA bundle:
# SSL_VERIFY=/etc/ssl/certs/your-ca-bundle.pem
SSL_VERIFY=true

# ── Retrieval Tuning ─────────────────────────────────────────
TOP_K=8
RETRIEVAL_CANDIDATES=20
USE_HYBRID_SEARCH=true
USE_RERANKER=true
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
MAX_SECTION_PAGES=25
MAX_CONTEXT_CHARS=14000

# ── Chunking ─────────────────────────────────────────────────
CHILD_CHUNK_SIZE=200
CHILD_CHUNK_OVERLAP=40
PARENT_MAX_CHARS=3000

# ── Context Focus ─────────────────────────────────────────────
CONTEXT_FOCUS_ENABLED=true
CONTEXT_FOCUS_MAX_SOURCES=5
CONTEXT_FOCUS_PAGE_GAP=0.35

# ── Role Attribute Data Source ────────────────────────────────
# "excel"  → read from local Excel files in ROLE_ATTR_DIR (default)
# "mssql"  → fetch live from a remote SQL Server (requires MSSQL_* vars below)
ROLE_DATA_SOURCE=mssql

# ── Remote MSSQL (only if ROLE_DATA_SOURCE=mssql) ────────────
# ODBC Driver 17 for SQL Server is installed in the Docker image automatically.
MSSQL_SERVER=<your-mssql-server-ip-or-hostname>
MSSQL_DATABASE=<your-database-name>
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TIMEOUT=30
# SQL Server domain login (DOMAIN\username format), or leave blank for Windows Auth
MSSQL_USER=<your-domain-username>
MSSQL_PASSWORD=<your-sql-server-password>

# ── Sync API (RDP proxy — only if using firewall-bridged MSSQL) ──
SYNC_API_KEY=<strong-random-secret>
